# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Your bot's application (client) ID, from the same Developer Portal page
DISCORD_CLIENT_ID=

# Optional: a guild (server) ID to register slash commands instantly for testing.
# Leave blank to register commands globally (takes up to 1 hour to propagate).
DISCORD_GUILD_ID=

# Path to the SQLite database file. On Railway, point this at a mounted volume
# so data survives redeploys, e.g. /data/ps99.db
DB_PATH=./data/ps99.db

# How often to poll the API and post updates, in minutes. Default 10.
POLL_INTERVAL_MINUTES=10
